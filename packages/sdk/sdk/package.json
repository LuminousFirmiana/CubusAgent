{
  "name": "@cubus/sdk",
  "version": "0.0.0",
  "description": "Headless SDK: JSON-RPC 2.0 protocol, server, and session runner over the kernel",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node --import tsx/esm examples/demo.ts"
  },
  "dependencies": {
    "@cubus/agent-recipe": "workspace:*",
    "@cubus/cordis": "workspace:*",
    "@cubus/session": "workspace:*"
  },
  "devDependencies": {
    "@cubus/host-local": "workspace:*",
    "@cubus/llm": "workspace:*",
    "@cubus/tool-registry": "workspace:*"
  }
}
