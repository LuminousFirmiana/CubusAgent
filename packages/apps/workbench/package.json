{
  "name": "@cubus/workbench",
  "version": "0.0.0",
  "description": "Local workbench HTTP server: sessions, live event streaming and resume over the SDK",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:api": "node --import tsx/esm examples/api-demo.ts",
    "start": "node --import tsx/esm src/main.ts"
  },
  "dependencies": {
    "@cubus/agent-recipe": "workspace:*",
    "@cubus/credentials": "workspace:*",
    "@cubus/git": "workspace:*",
    "@cubus/git-cli": "workspace:*",
    "@cubus/host-local": "workspace:*",
    "@cubus/llm-deepseek": "workspace:*",
    "@cubus/recipe-coding-agent": "workspace:*",
    "@cubus/sdk": "workspace:*",
    "@cubus/session": "workspace:*",
    "@cubus/tool-approval": "workspace:*",
    "@cubus/tools": "workspace:*"
  },
  "devDependencies": {
    "@cubus/llm": "workspace:*"
  }
}
