{
  "name": "@cubus/cli",
  "version": "0.0.0",
  "description": "Headless CubusAgent command-line application",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node --import tsx/esm src/main.ts",
    "demo:live": "node --import tsx/esm examples/live-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cubus/budget": "workspace:*",
    "@cubus/credentials": "workspace:*",
    "@cubus/git": "workspace:*",
    "@cubus/git-cli": "workspace:*",
    "@cubus/host-local": "workspace:*",
    "@cubus/llm-deepseek": "workspace:*",
    "@cubus/recipe-coding-agent": "workspace:*",
    "@cubus/recipe-cubus-coding-agent": "workspace:*",
    "@cubus/sdk": "workspace:*",
    "@cubus/session": "workspace:*",
    "@cubus/tool-approval": "workspace:*",
    "@cubus/tools": "workspace:*"
  },
  "devDependencies": {
    "@cubus/llm": "workspace:*",
    "@cubus/session-jsonl": "workspace:*"
  }
}
