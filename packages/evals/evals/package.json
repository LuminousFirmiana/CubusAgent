{
  "name": "@cubus/evals",
  "version": "0.0.0",
  "description": "Eval harness: repair tasks over fixture repos with hidden-test scoring",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:real": "node --import tsx/esm src/run.ts"
  },
  "dependencies": {
    "@cubus/agent-recipe": "workspace:*",
    "@cubus/host-local": "workspace:*",
    "@cubus/llm": "workspace:*",
    "@cubus/llm-retry": "workspace:*",
    "@cubus/recipe-reference-agent": "workspace:*",
    "@cubus/recipe-repair-eval": "workspace:*",
    "@cubus/sdk": "workspace:*",
    "@cubus/session": "workspace:*",
    "@cubus/session-jsonl": "workspace:*",
    "@cubus/tool-approval": "workspace:*",
    "@cubus/tools": "workspace:*"
  }
}
