{
  "name": "@cubus/mcp",
  "version": "0.0.0",
  "description": "MCP tool source: minimal JSON-RPC client over stdio and Streamable HTTP",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node --import tsx/esm examples/connect-demo.ts",
    "demo:expose": "node --import tsx/esm examples/expose-demo.ts"
  },
  "dependencies": {
    "@cubus/agent-recipe": "workspace:*",
    "@cubus/cordis": "workspace:*",
    "@cubus/system-prompt": "workspace:*",
    "@cubus/tool-registry": "workspace:*"
  },
  "devDependencies": {
    "@cubus/recipe-coding-agent": "workspace:*"
  }
}
